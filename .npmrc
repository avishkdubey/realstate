# Generous network timeouts.
#
# A default-timeout `npm install` on this connection failed part-way through and
# left two packages truncated *without* failing loudly: @next/swc-linux-x64-gnu
# arrived at 13.7MB instead of 96.6MB, and maplibre-gl lost its .d.ts. The
# symptom was `next build` dying with "Bus error (core dumped)" — a corrupt
# native binary being mmap'd — which looks nothing like a download problem and
# cost real time to trace. See HANDOFF.md §2.
fetch-timeout=600000
fetch-retries=5
fetch-retry-maxtimeout=120000
